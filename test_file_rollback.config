resources {
  # Test 1: Create a file
  resource {
    type "file"
    destination "test_rollback/create_test.txt"

    actions {
      file {
        operation "create"
        content "This is a test file for rollback testing.\nCreated at: {{timestamp}}"
        create_directories "true"
        backup_original "false"
      }
    }
  }

  # Test 2: Create a file with backup
  resource {
    type "file"
    destination "test_rollback/backup_test.txt"

    actions {
      file {
        operation "create"
        content "Original content that will be backed up"
        create_directories "true"
        backup_original "true"
      }
    }
  }

  # Test 3: Edit a file (append mode)
  resource {
    type "file"
    destination "test_rollback/create_test.txt"

    actions {
      file {
        operation "edit"
        content "\nThis line was appended after creation"
        edit_mode "append"
        backup_original "true"
      }
    }
  }

  # Test 4: Edit a file (replace mode)
  resource {
    type "file"
    destination "test_rollback/backup_test.txt"

    actions {
      file {
        operation "edit"
        content "This content completely replaces the original"
        edit_mode "replace"
        backup_original "true"
      }
    }
  }

  # Test 5: Remove a file
  resource {
    type "file"
    destination "test_rollback/remove_test.txt"

    actions {
      file {
        operation "create"
        content "This file will be removed"
        create_directories "true"
      }
    }
  }

  # Test 6: Remove the file we just created
  resource {
    type "file"
    destination "test_rollback/remove_test.txt"

    actions {
      file {
        operation "remove"
        backup_original "true"
      }
    }
  }
}
