# UFW block: manage uncomplicated firewall

# Enable the firewall
ufw {
  state = "enabled"
}

# Allow SSH
ufw {
  rule = "allow"
  port = "22"
  proto = "tcp"
}

# Allow HTTP/HTTPS
ufw {
  rule = "allow"
  port = "80"
  proto = "tcp"
}

ufw {
  rule = "allow"
  port = "443"
  proto = "tcp"
}

# Deny a specific port
ufw {
  rule = "deny"
  port = "3306"
  proto = "tcp"
  direction = "in"
}
