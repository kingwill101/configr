set $zed_version v0.168.2
set $destination zed.zip
set $extract_name zed

resource {
  type "file"
  source "https://github.com/zed-industries/zed/archive/refs/tags/$zed_version.zip"
  actions {
        download github {
            overwrite true
            destination $destination
        }

        decompress decompress_zed {
            source $destination
            destination $extract_name
        }

        delete delete_zed_zip {
            source $destination
        }
    }
}
