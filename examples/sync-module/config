resources {
  # Basic bidirectional sync example
  resource {
    id "basic-sync"
    source "source_dir"
    destination "destination_dir"

    actions {
      sync {
        sync_mode "bidirectional"
        conflict_resolution "newer"
        preserve_permissions true
        preserve_timestamps true
        delete_orphans false
      }
    }
  }

  # Document backup with filtering and hooks
  resource {
    id "document-backup"
    source "documents"
    destination "backup/documents"

    actions {
      # Before hook - create backup directory and log
      before {
        echo {
          message "Starting document backup operation"
          level "info"
          color true
        }
      }

      before {
        execute {
          command "mkdir -p backup/documents"
          on_success true
        }
      }

      sync {
        sync_mode "source_to_dest"
        conflict_resolution "newer"
        exclude "*.tmp, *.swp, .DS_Store, Thumbs.db"
        preserve_permissions true
        preserve_timestamps true
        delete_orphans false
      }

      # After hook - verify backup and show statistics
      after {
        echo {
          message "Document backup completed successfully"
          level "success"
          color true
        }
      }

      after {
        execute {
          command "du -sh backup/documents"
          on_success true
        }
      }
    }
  }

  # Project sync with selective files
  resource {
    id "project-sync"
    source "project"
    destination "backup/project"

    actions {
      sync {
        sync_mode "source_to_dest"
        conflict_resolution "source"
        include "*.dart, *.yaml, *.md, pubspec.*, *.json"
        exclude "*.log, build/, .dart_tool/, node_modules/"
        preserve_permissions true
        preserve_timestamps true
        delete_orphans true
      }
    }
  }

  # Config sync with strict source preference
  resource {
    id "config-sync"
    source "configs"
    destination "backup/configs"

    actions {
      sync {
        sync_mode "source_to_dest"
        conflict_resolution "source"
        include "*.conf, *.cfg, *.ini, *.json"
        preserve_permissions true
        preserve_timestamps true
        delete_orphans true
      }
    }
  }

  # Media sync with size-based conflict resolution
  resource {
    id "media-sync"
    source "media"
    destination "backup/media"

    actions {
      sync {
        sync_mode "source_to_dest"
        conflict_resolution "larger"
        include "*.jpg, *.jpeg, *.png, *.gif, *.mp4, *.mov, *.avi"
        preserve_permissions false
        preserve_timestamps true
        delete_orphans false
      }
    }
  }
}
