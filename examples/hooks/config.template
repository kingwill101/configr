# Application Configuration
# Generated from template on {{ "now" | date: "%Y-%m-%d %H:%M:%S" }}

[application]
name = "{{ app_name }}"
version = "{{ version }}"
debug = {{ debug | downcase }}
port = {{ port }}
host = "{{ host }}"

{% if debug %}
[logging]
level = "debug"
file = "/var/log/{{ app_name | downcase }}.log"
{% endif %}

[server]
listen_address = "{{ host }}:{{ port }}"
max_connections = 100
timeout = 30

