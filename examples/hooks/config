# Hooks Example - Demonstrating before and after hooks
# This example shows how to use hooks to add logging, validation, and cleanup
# around your main operations.

resources {
  # Example 1: File copy with logging hooks
  resource {
    id "copy-with-logging"
    source "source_file.txt"
    destination "destination_file.txt"
    
    actions {
      # Before hook - log the start of operation
      before {
        echo {
          message "Starting file copy operation"
          level "info"
          color true
        }
      }
      
      # Main action - copy the file
      copy {
        overwrite true
        backup_original true
      }
      
      # After hook - log completion and verify
      after {
        echo {
          message "File copy completed successfully"
          level "info"
          color true
        }
      }
    }
  }

  # Example 2: Download with validation hooks
  resource {
    id "download-with-validation"
    source "https://httpbin.org/json"
    destination "downloaded_data.json"
    
    actions {
      # Before hook - check if destination exists
      before {
        echo {
          message "Checking if download destination exists"
          level "info"
        }
      }
      
      # Main action - download the file
      download {
        timeout 30
        retry_count 3
      }
      
      # After hook - validate the downloaded file
      after {
        validate {
          file_path "downloaded_data.json"
          schema_type "json"
          required_fields ["slideshow", "slides"]
        }
      }
    }
  }

  # Example 3: Template processing with backup and cleanup hooks
  resource {
    id "template-with-backup"
    source "config.template"
    destination "generated_config.conf"
    
    actions {
      # Before hook - create backup of existing config
      before {
        backup {
          source "generated_config.conf"
          destination "backups/config_backup_$(date +%Y%m%d_%H%M%S).conf"
          create_destination true
        }
      }
      
      # Main action - process template
      template {
        app_name "MyApplication"
        version "1.0.0"
        debug false
        port 8080
        host "localhost"
      }
      
      # After hook - validate generated config and restart service
      after {
        echo {
          message "Template processed, restarting service"
          level "info"
        }
        execute {
          command "systemctl reload myapp"
          on_success true
          timeout 10
        }
      }
    }
  }

  # Example 4: Package installation with system checks
  resource {
    id "package-with-checks"
    source "system"
    destination "system"
    
    actions {
      # Before hook - check system requirements
      before {
        echo {
          message "Checking system requirements before package installation"
          level "info"
        }
        execute {
          command "df -h /"
          on_success true
        }
      }
      
      # Main action - install packages
      package {
        packages ["curl", "wget", "git"]
        manager "auto"
        update_cache true
        skip_installed true
      }
      
      # After hook - verify installation and show status
      after {
        echo {
          message "Package installation completed, verifying..."
          level "info"
        }
        execute {
          command "which curl wget git"
          on_success true
        }
      }
    }
  }

  # Example 5: Complex workflow with multiple hooks
  resource {
    id "complex-workflow"
    source "app_source"
    destination "app_destination"
    
    actions {
      # Before hooks - multiple preparation steps
      before {
        echo {
          message "Starting complex deployment workflow"
          level "info"
          color true
        }
      }
      
      before {
        execute {
          command "mkdir -p app_destination"
          on_success true
        }
      }
      
      # Main actions - multiple operations
      copy {
        source "app_source"
        destination "app_destination"
        overwrite true
        recursive true
      }
      
      permissions {
        path "app_destination"
        mode "755"
        recursive true
      }
      
      # After hooks - cleanup and verification
      after {
        echo {
          message "Deployment completed, running post-deployment checks"
          level "info"
        }
      }
      
      after {
        execute {
          command "ls -la app_destination"
          on_success true
        }
      }
      
      after {
        echo {
          message "Complex workflow completed successfully"
          level "success"
          color true
        }
      }
    }
  }
}
