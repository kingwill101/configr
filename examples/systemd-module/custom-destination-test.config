# Custom destination test - demonstrates custom file locations
resource {
  type "file"
  source "/dev/null"

  actions {
    systemd {
      service "custom-app"
      type "service"
      description "Custom Application Service"
      exec_start "/usr/local/bin/custom-app --daemon"
      user "custom"
      group "custom"
      working_directory "/opt/custom"
      restart_policy "on-failure"
      restart_sec 5
      
      # Custom destination - override default location (user-writable)
      destination "/tmp/custom-app.service"
      
      # System service settings
      user_service false
      require_privilege_escalation true
      overwrite true
      
      wanted_by "multi-user.target"
    }
  }
}
