# System service example (requires privilege escalation)
resource {
  type "file"
  source "/dev/null"

  actions {
    systemd {
      service "myapp"
      type "service"
      description "My Application Service"
      exec_start "/usr/bin/myapp --daemon"
      user "myapp"
      group "myapp"
      working_directory "/opt/myapp"
      environment "NODE_ENV=production,PORT=3000"
      dependencies "network.target,postgresql.service"
      restart_policy "on-failure"
      restart_sec 5
      timeout_start_sec 30
      timeout_stop_sec 30
      enabled true
      wanted_by "multi-user.target"

      # System service settings
      user_service false
      require_privilege_escalation true

      # Advanced systemd options (inspired by Chef/Puppet)
      private_tmp true
      protect_system true
      protect_home true
      no_new_privileges true
      read_write_paths "/opt/myapp/data,/var/log/myapp"
      read_only_paths "/opt/myapp/config"

      # Resource limits
      resource_limits {
        NOFILE "65536"
        NPROC "4096"
        MEMLOCK "infinity"
      }

      # Security options
      security_options {
        CapabilityBoundingSet "CAP_NET_BIND_SERVICE CAP_SYS_TIME"
        AmbientCapabilities "CAP_NET_BIND_SERVICE"
      }

      # Logging
      syslog_identifier "myapp"
      syslog_facility 3
      syslog_level "info"
    }
  }
}

# User service example (no privilege escalation needed)
resource {
  type "file"
  source "/dev/null"

  actions {
    systemd {
      service "myuserapp"
      type "service"
      description "My User Application Service"
      exec_start "/home/user/bin/myuserapp --daemon"
      user "user"
      group "user"
      working_directory "/home/user/app"
      environment "NODE_ENV=development,PORT=3001"
      restart_policy "on-failure"
      restart_sec 5

      # User service settings
      user_service true
      require_privilege_escalation false

      # User services have different target
      wanted_by "default.target"
    }
  }
}

# Example of a systemd drop-in file
resource {
  type "file"
  source "/dev/null"

  actions {
    systemd {
      service "myapp"
      type "service"
      is_drop_in true
      drop_in_name "production"
      description "Production overrides for My Application"

      # Override only specific settings
      environment "NODE_ENV=production,LOG_LEVEL=warn"
      restart_policy "always"
      restart_sec 10

      # Additional security for production
      private_tmp true
      protect_system true
      no_new_privileges true
    }
  }
}

# Example of a systemd timer
resource {
  type "file"
  source "/dev/null"

  actions {
    systemd {
      service "backup"
      type "timer"
      description "Daily backup timer"

      # Timer configuration
      on_calendar "daily"
      persistent true
      randomized_delay_sec 300
    }
  }
}
