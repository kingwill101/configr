# User service test (no privilege escalation needed)
resource {
  type "file"
  source "/dev/null"

  actions {
    systemd {
      service "test-user-service"
      type "service"
             description "Test User Service Cross-Platform"
      exec_start "/bin/echo 'Hello from user service'"
      user "user"
      group "user"
      working_directory "/tmp"
      restart_policy "on-failure"
      restart_sec 5
      
      # User service settings
      user_service true
      require_privilege_escalation false
      
      # User services have different target
      wanted_by "default.target"
    }
  }
}
