# package-managers — demonstrates all supported package manager types
#
# Usage:
#   configr apply -n --dry-run        # preview (safe — no changes)
#   configr apply -n                   # execute (requires matching OS)
#
# Supported managers:
#   apt     — Debian/Ubuntu
#   pacman  — Arch Linux
#   pamac   — Manjaro
#   npm     — Node.js (works anywhere with node installed)
#   docker  — container images (works anywhere with docker)
#
# NOTE: Included per-manager configs use `skip_if_installed = true`
# by default, so they only act if the package isn't already present.

# Phase 1: apt packages (Debian/Ubuntu)
include apt.conf

# Phase 2: npm global packages
include npm.conf

# Phase 3: docker images
include docker.conf
