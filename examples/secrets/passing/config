secrets {
    username = "env://USER"
    greeting = "cmd://echo hello_from_cmd"
    local_hostname = "file:///etc/hostname"
    db_password = "cmd://grep DB_PASSWORD .env | cut -d= -f2"
    api_key = "cmd://grep API_KEY .env | cut -d= -f2"
    dotenv_key = "dotenv:///tmp/configr_dotenv_example/.env?name=API_KEY"
}

execute {
    command = "echo 'user=$secrets_username greeting=$secrets_greeting host=$secrets_local_hostname db=$secrets_db_password dotenv=$secrets_dotenv_key api=$secrets_api_key'"
}
