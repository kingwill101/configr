# Secret providers reference
# Each example shows the URI syntax for a different provider.
#
# Providers that resolve successfully are uncommented; ones requiring
# external tools (1Password CLI, secret-tool) are commented out.

secrets {
    # ── env:// ── reads from process environment ──────────────────────
    #   Syntax: env://VARIABLE_NAME
    username = "env://USER"

    # ── cmd:// ── runs /bin/sh -c, captures stdout ────────────────────
    #   Syntax: cmd://shell command
    #   Returns null if exit code != 0.
    greeting = "cmd://echo hello_from_cmd"

    # ── file:// ── reads file content (absolute path) ─────────────────
    #   Syntax: file:///absolute/path/to/file
    local_hostname = "file:///etc/hostname"

    # ── dotenv:// ── loads a .env file, reads one variable ────────────
    #   Syntax: dotenv:///absolute/path/.env?name=KEY
    #   The .env file path must be absolute; ?name= specifies which
    #   variable to return from within the file.
    #db_password = "dotenv:///path/to/.env?name=DB_PASSWORD"

    # ── onepassword:// ── reads from 1Password CLI (op) ──────────────
    #   Syntax: onepassword://vault/item/field
    #   Requires the 1Password CLI (`op`) to be installed and authenticated.
    #   Optionally append ?profile=<account> for non-default accounts.
    #github_token = "onepassword://Personal/gh-token/credential"

    # ── keyring:// ── reads from Linux secret-service (secret-tool) ──
    #   Syntax: keyring://service_name/account_name
    #   Requires `secret-tool` (libsecret) to be installed.
    #   Looks up: secret-tool lookup service <service_name> account <account_name>
    #ci_key = "keyring://configr/ci-access-token"

    # ── Provider aliases ──────────────────────────────────────────────
    #   Define a shorthand alias for a provider URI prefix.
    #   Then use the alias instead of the full scheme.
    provider "prod" = "env://"
    #provider "vault" = "cmd://vault kv get -field=value -mount=secret/"
    #db_password = "prod://DB_PASSWORD"
    #api_key = "vault://myapp/api_key"
}

execute {
    command = "echo 'user=$secrets_username greeting=$secrets_greeting host=$secrets_local_hostname'"
}
