# Secrets configuration example
secrets {
    profile = "personal"
    provider "prod" = "env://"

    # Resolved from environment variable
    github_token = "env://GITHUB_TOKEN"

    # Resolved from file
    docker_key = "file:///run/secrets/docker_hub_key"

    # Resolved by running a command
    vault_password = "cmd://echo s3cret"

    # Resolved from a .env file
    db_password = "dotenv:///etc/myapp/.env"
}

# Use resolved secrets via $secrets_<key> syntax
execute {
    command = "deploy --token $secrets_github_token"
}

copy {
    source = "app.conf.template"
    destination = "/etc/app.conf"
    content = "DB_PASSWORD=$secrets_db_password"
}
