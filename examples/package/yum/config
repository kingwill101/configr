# YUM Package Manager — RHEL / CentOS 7
#
# Usage:
#   configr apply -n --dry-run        # preview
#   configr apply -n                   # execute (requires sudo)

# Development tools
yum {
  source = "git curl wget vim nano htop tree gcc make"
  operation = "install"
  update_cache = true
  skip_if_installed = true
}

# Web server stack
yum {
  source = "nginx php-fpm mariadb-server redis"
  operation = "install"
  update_cache = true
  skip_if_installed = false
}

# Security tools
yum {
  source = "fail2ban policycoreutils clamav"
  operation = "install"
  update_cache = true
  skip_if_installed = true
}

# System utilities
yum {
  source = "htop iotop ncdu rsync zip unzip jq"
  operation = "install"
  update_cache = true
  skip_if_installed = true
}
