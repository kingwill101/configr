resources {
  # Local package installation (project dependencies)
  resource {
    id "local-dependencies"
    source "/tmp"
    destination "/tmp"
    
    actions {
      before {
        echo {
          message "Installing packages locally for project dependencies"
          level "info"
          color true
        }
      }
      
      # Create package.json for local installation
      copy {
        source "../examples/package.json"
        destination "package.json"
        create_directories true
      }
      
      package {
        packages ["express", "cors", "helmet", "morgan", "dotenv"]
        package_versions {
          express "4.18.0"
          cors "2.8.5"
        }
        operation "install"
        package_manager "npm"
        install_globally false
        update_cache false
        skip_if_installed true
      }
      
      after {
        execute {
          command "npm list"
          on_success true
        }
      }
    }
  }

  # Development dependencies (local)
  resource {
    id "local-dev-dependencies"
    source "/tmp"
    destination "/tmp"
    
    actions {
      package {
        packages ["typescript", "eslint", "prettier", "nodemon", "ts-node"]
        package_versions {
          typescript "5.0.0"
          eslint "8.0.0"
        }
        operation "install"
        package_manager "npm"
        install_globally false
        update_cache false
        skip_if_installed true
      }
    }
  }

  # Testing dependencies (local)
  resource {
    id "local-test-dependencies"
    source "/tmp"
    destination "/tmp"
    
    actions {
      package {
        packages ["jest", "mocha", "chai", "supertest"]
        package_versions {
          jest "29.0.0"
          mocha "10.0.0"
        }
        operation "install"
        package_manager "npm"
        install_globally false
        update_cache false
        skip_if_installed true
      }
    }
  }
}
