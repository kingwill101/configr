resources {
  # Test rollback with force installation
  resource {
    id "rollback-test"
    source "/tmp"
    destination "/tmp"
    
    actions {
      before {
        echo {
          message "Installing packages for rollback test"
          level "info"
          color true
        }
      }
      
      # Create package.json for local installation
      copy {
        source "../examples/package.json"
        destination "package.json"
        create_directories true
      }
      
      package {
        packages ["express", "cors"]
        package_versions {
          express "4.18.0"
          cors "2.8.5"
        }
        operation "install"
        package_manager "npm"
        install_globally false
        update_cache false
        skip_if_installed false
        force true
      }
      
      after {
        execute {
          command "npm list express cors"
          on_success true
        }
      }
    }
  }
}
