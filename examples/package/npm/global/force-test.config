resources {
  # Force installation test
  resource {
    id "force-install-test"
    source "/tmp"
    destination "/tmp"
    
    actions {
      before {
        echo {
          message "Force installing packages for rollback test"
          level "info"
          color true
        }
      }
      
      package {
        packages ["typescript", "eslint", "prettier"]
        package_versions {
          typescript "5.0.0"
          eslint "8.0.0"
        }
        operation "install"
        package_manager "npm"
        install_globally true
        update_cache false
        skip_if_installed false
        force true
      }
      
      after {
        execute {
          command "npm list -g --depth=0"
          on_success true
        }
      }
    }
  }
}
