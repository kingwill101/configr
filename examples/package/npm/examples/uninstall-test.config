resources {
  # Test package uninstallation
  resource {
    id "uninstall-test"
    source "/tmp"
    destination "/tmp"
    
    actions {
      before {
        echo {
          message "Testing package uninstallation"
          level "info"
          color true
        }
      }
      
      package {
        packages ["old-package", "unused-tool", "deprecated-app"]
        operation "uninstall"
        package_manager "npm"
        install_globally true
        skip_if_installed true
      }
      
      after {
        execute {
          command "npm list -g --depth=0"
          on_success true
        }
      }
    }
  }
}
