resources {
  # Test package upgrades
  resource {
    id "upgrade-test"
    source "/tmp"
    destination "/tmp"
    
    actions {
      before {
        echo {
          message "Testing package upgrades"
          level "info"
          color true
        }
      }
      
      package {
        packages ["typescript", "eslint", "prettier"]
        package_versions {
          typescript "5.1.0"
          eslint "8.1.0"
          prettier "3.1.0"
        }
        operation "upgrade"
        package_manager "npm"
        install_globally true
        skip_if_installed true
      }
      
      after {
        execute {
          command "npm list -g --depth=0"
          on_success true
        }
      }
    }
  }
}
