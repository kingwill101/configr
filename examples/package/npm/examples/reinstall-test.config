resources {
  # Test package reinstallation
  resource {
    id "reinstall-test"
    source "/tmp"
    destination "/tmp"
    
    actions {
      before {
        echo {
          message "Testing package reinstallation"
          level "info"
          color true
        }
      }
      
      package {
        packages ["typescript", "eslint"]
        package_versions {
          typescript "5.0.0"
          eslint "8.0.0"
        }
        operation "reinstall"
        package_manager "npm"
        install_globally true
        force true
        update_cache false
      }
      
      after {
        execute {
          command "npm list -g --depth=0"
          on_success true
        }
      }
    }
  }
}
