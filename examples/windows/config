# ==============================================================================
# Configr Windows Demo
# ==============================================================================
# Runs against a Windows target via SSH, exercising every subsystem:
#   - Platform strategies (PowerShell, cmd, native Windows paths)
#   - Lua + PowerShell hooks (pre-apply, post-apply, pre-block, post-block)
#   - Pre/post apply scripts
#   - Network operations (HTTP, download, DNS, TCP)
#   - File operations (create, edit, copy, delete, move, symlink)
#   - Archive operations (compress / decompress)
#   - System introspection (slurp, stat, gather_facts, set_fact)
#
# Usage:
#   configr --v2 -c examples/windows/config apply \
#     --host WIN_IP --ssh-user USER \
#     --var demo_root="C:/temp/configr_demo" \
#     --var httpbin="https://httpbin.org"
#
# Prerequisites on the Windows target:
#   - OpenSSH Server enabled + running
#   - PowerShell 5.1+ (preferably PowerShell 7 / pwsh.exe)
#   - 7-Zip (for compress / decompress blocks using .zip)
# ==============================================================================

# ---------------------------------------------------------------------------
# Connection is handled via CLI --host/--ssh-user/--ssh-password flags.
# No inline connection block needed here.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Pre-apply scripts - run BEFORE any block executes
# Commands run through ScriptStrategy -> PowerShell on Windows
# ---------------------------------------------------------------------------
pre_apply_scripts {
    script = "New-Item -ItemType Directory -Force -Path '$demo_root' | Out-Null"
    script = "Write-Host 'Configr Windows Demo Starting'"
}

# ---------------------------------------------------------------------------
# set_fact - define reusable variables
# ---------------------------------------------------------------------------
set_fact {
    name = "demo_root"
    value = "$demo_root"
}

set_fact {
    name = "httpbin"
    value = "$httpbin"
}

# ---------------------------------------------------------------------------
# echo - informational output
# ---------------------------------------------------------------------------
echo {
    message = "Starting Windows demo at $demo_root"
    level = "info"
}

# ---------------------------------------------------------------------------
# gather_facts - collect system facts into a variable
# ---------------------------------------------------------------------------
gather_facts {
    destination = "$demo_root/facts.json"
}

# ---------------------------------------------------------------------------
# execute - run arbitrary PowerShell commands
# ---------------------------------------------------------------------------
execute {
    command = "Get-ComputerInfo | Select-Object CsName, WindowsVersion, WindowsBuildLabEx | Format-List"
    creates = "$demo_root/computer_info.txt"
}

execute {
    command = "Get-Process | Sort-Object CPU -Descending | Select-Object -First 5 Name, CPU, WorkingSet64 | Format-Table | Out-File -Encoding utf8 '$demo_root/processes.txt'"
    working_directory = "$demo_root"
}

# ---------------------------------------------------------------------------
# raw - run cmd.exe commands
# ---------------------------------------------------------------------------
raw {
    command = "echo %DATE% %TIME% > $demo_root/timestamp.txt"
    executable = "cmd"
}

# ---------------------------------------------------------------------------
# file - create marker files
# ---------------------------------------------------------------------------
file {
    file_path = "$demo_root/started.marker"
    content = "started"
    operation = "create"
}

# ---------------------------------------------------------------------------
# file - write content (create / edit files)
# ---------------------------------------------------------------------------
file {
    file_path = "$demo_root/hello.txt"
    content = "Hello from Configr on Windows!\nGenerated by Configr"
    operation = "create"
}

file {
    file_path = "$demo_root/hello.txt"
    content = "\nAppended line from Configr"
    operation = "edit"
    edit_mode = "append"
}

# ---------------------------------------------------------------------------
# stat - inspect file metadata
# ---------------------------------------------------------------------------
stat {
    path = "$demo_root/hello.txt"
}

# ---------------------------------------------------------------------------
# slurp - read file contents into a variable
# ---------------------------------------------------------------------------
slurp {
    src = "$demo_root/hello.txt"
}

# ---------------------------------------------------------------------------
# copy - copy files
# ---------------------------------------------------------------------------
copy {
    source = "$demo_root/hello.txt"
    destination = "$demo_root/hello_copy.txt"
}

# ---------------------------------------------------------------------------
# move / rename - move files
# ---------------------------------------------------------------------------
move {
    source = "$demo_root/hello_copy.txt"
    destination = "$demo_root/hello_moved.txt"
    overwrite = true
}

# ---------------------------------------------------------------------------
# backup - safe backup of a file
# ---------------------------------------------------------------------------
backup {
    source = "$demo_root/hello.txt"
    destination = "$demo_root/hello.txt.bak"
}

# ---------------------------------------------------------------------------
# symlink - create a symbolic link
# ---------------------------------------------------------------------------
symlink {
    source = "$demo_root/hello.txt"
    destination = "$demo_root/hello_link.txt"
    overwrite = true
}

# ---------------------------------------------------------------------------
# lineinfile - manage a single line in a file
# ---------------------------------------------------------------------------
lineinfile {
    path = "$demo_root/hello.txt"
    line = "# Managed by Configr"
    regexp = "^# Managed by Configr"
    state = "present"
}

lineinfile {
    path = "$demo_root/hello.txt"
    line = "This line was removed"
    regexp = "removed"
    state = "absent"
}

# ---------------------------------------------------------------------------
# blockinfile - manage a multi-line block
# ---------------------------------------------------------------------------
blockinfile {
    path = "$demo_root/hello.txt"
    marker = "# {mark} CONFIGR BLOCK"
    block = "configr_block_start\n  managed = true\n  platform = windows\nconfigr_block_end"
    state = "present"
    create = true
}

# ---------------------------------------------------------------------------
# replace - text pattern replacement
# ---------------------------------------------------------------------------
replace {
    path = "$demo_root/hello.txt"
    regexp = "Configr"
    replace = "configr"
    state = "present"
}

# ---------------------------------------------------------------------------
# download - fetch a remote file (uses PowerShell Invoke-WebRequest)
# ---------------------------------------------------------------------------
download {
    source = "$httpbin/json"
    destination = "$demo_root/httpbin_response.json"
    checksum = ""
}

download {
    source = "$httpbin/robots.txt"
    destination = "$demo_root/robots.txt"
}

# ---------------------------------------------------------------------------
# uri - HTTP request with status checking
# ---------------------------------------------------------------------------
uri {
    url = "$httpbin/status/200"
    method = "GET"
    expected_status = 200
    body = ""
}

uri {
    url = "$httpbin/post"
    method = "POST"
    body = "{\"test\": true}"
    expected_status = 200
}

# ---------------------------------------------------------------------------
# compress - create a zip archive
# ---------------------------------------------------------------------------
compress {
    source = "$demo_root/hello.txt"
    destination = "$demo_root/archive.zip"
    format = "zip"
}

# ---------------------------------------------------------------------------
# decompress - extract the archive
# ---------------------------------------------------------------------------
decompress {
    source = "$demo_root/archive.zip"
    destination = "$demo_root/extracted"
    format = "zip"
}

# ---------------------------------------------------------------------------
# delete - clean up extracted files
# ---------------------------------------------------------------------------
delete {
    source = "$demo_root/extracted"
    recursive = true
}

# ---------------------------------------------------------------------------
# assert - verify expectations
# ---------------------------------------------------------------------------
assert {
    condition = "$os_name == windows"
    fail_msg = "Target must be Windows"
}

# ---------------------------------------------------------------------------
# debug - print debug info
# ---------------------------------------------------------------------------
debug {
    message = "Demo complete. All files are in $demo_root"
}

# ---------------------------------------------------------------------------
# Post-apply scripts - run AFTER all blocks
# ---------------------------------------------------------------------------
post_apply_scripts {
    script = "Write-Host 'Configr Windows Demo Complete'"
    script = "Get-ChildItem '$demo_root'"
}
